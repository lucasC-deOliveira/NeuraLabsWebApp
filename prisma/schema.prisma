generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==========================================
// USUARIO
// ==========================================
model Usuario {
  id           String    @id @default(cuid())
  nome         String
  email        String    @unique
  senhaHash    String    @map("senha_hash")
  dataCriacao  DateTime  @default(now()) @map("data_criacao")
  ultimoAcesso DateTime? @map("ultimo_acesso")

  flashcards        Flashcard[]
  sessoesEstudo     SessaoEstudo[]
  aprendizagens     AprendizadoFlashcard[]
  desempenhoNos     DesempenhoNo[]
  notas             Nota[]
  textosBrutos      TextoBruto[]
  configAI          ConfigAI?
  assuntos          Assunto[]
  nodesConhecimento NodeConhecimento[]
  grafos            GrafosConhecimento[]
  topicos           Topico[]
  conceitos         Conceito[]

  @@map("usuarios")
}

// ==========================================
// ENTIDADES BASE (SEM RELAÇÕES ENTRE SI)
// ==========================================

// ASSUNTO
model Assunto {
  id        String  @id @default(cuid())
  usuarioId String  @map("id_usuario")
  nome      String
  descricao String?

  usuario Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  topicos Topico[]

  @@map("assuntos")
}

// TOPICO
model Topico {
  id        String  @id @default(cuid())
  usuarioId String  @map("id_usuario")
  assuntoId String? @map("id_assunto")
  nome      String
  descricao String?

  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  assunto   Assunto?  @relation(fields: [assuntoId], references: [id], onDelete: SetNull)
  conceitos Conceito[]

  @@map("topicos")
}

// CONCEITO
model Conceito {
  id        String  @id @default(cuid())
  usuarioId String  @map("id_usuario")
  topicoId  String? @map("id_topico")
  nome      String
  descricao String?

  usuario    Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  topico     Topico?     @relation(fields: [topicoId], references: [id], onDelete: SetNull)
  flashcards Flashcard[]

  @@map("conceitos")
}

// FLASHCARD
model Flashcard {
  id          String   @id @default(cuid())
  conceitoId  String?  @map("id_concept") // opcional agora
  usuarioId   String   @map("id_usuario")
  pergunta    String
  resposta    String
  dataCriacao DateTime @default(now()) @map("data_criacao")

  conceito    Conceito?              @relation(fields: [conceitoId], references: [id], onDelete: Cascade)
  usuario     Usuario                @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  revisoes    RevisaoFlashcard[]
  aprendizado AprendizadoFlashcard[]

  @@map("flashcards")
}

// NOTA
model Nota {
  id          String   @id @default(cuid())
  usuarioId   String   @map("id_usuario")
  titulo      String   @default("Sem título")
  // Zettelkasten: LITERATURA (notas de referência), PERMANENTE (uma ideia,
  // suas palavras) ou ESTRUTURA (índice/mapa de conhecimento)
  tipoNota    String   @default("PERMANENTE") @map("tipo_nota")
  // subtipo do conteúdo: DEFINICAO, EXPLICACAO, EXEMPLO, COMPARACAO,
  // SINTESE, PREREQUISITO, ERRO_COMUM ou APLICACAO
  subtipo     String?
  fonte       String?  // origem da nota de literatura (livro, artigo, vídeo...)
  // identificador único estilo Zettelkasten: timestamp de criação + título
  slug        String?
  conteudo    String
  dataCriacao DateTime @default(now()) @map("data_criacao")
  dataAtualizacao DateTime @default(now()) @updatedAt @map("data_atualizacao")

  usuario        Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  arestasOrigem  ConhecimentoAresta[] @relation("ArestaNotaOrigem")
  arestasDestino ConhecimentoAresta[] @relation("ArestaNotaDestino")

  @@map("notas")
}

// TEXTO_BRUTO — texto original/fonte do qual notas são geradas (relação GERA)
model TextoBruto {
  id          String   @id @default(cuid())
  usuarioId   String   @map("id_usuario")
  titulo      String   @default("Texto sem título")
  texto       String
  dataCriacao DateTime @default(now()) @map("data_criacao")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("textos_brutos")
}

// ==========================================
// GRAFO
// ==========================================
model GrafosConhecimento {
  id              String   @id @default(cuid())
  usuarioId       String   @map("id_usuario")
  nome            String
  descricao       String?
  estadoVisual    String?  @map("estado_visual")
  dataCriacao     DateTime @default(now()) @map("data_criacao")
  dataAtualizacao DateTime @default(now()) @updatedAt @map("data_atualizacao")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  nodes   NodeConhecimento[]
  arestas ConhecimentoAresta[]

  @@map("grafos_conhecimento")
}

// ==========================================
// NODE UNIVERSAL (CAMADA DE GRAFO)
// ==========================================
enum TipoNode {
  ASSUNTO
  TOPICO
  CONCEITO
  FLASHCARD
  NOTA
  TEXTO_BRUTO
  QUESTION
}

model NodeConhecimento {
  id        String  @id @default(cuid())
  usuarioId String  @map("id_usuario")
  grafoId   String? @map("id_grafo")

  tipoNode TipoNode

  // 👇 APONTA PARA QUALQUER ENTIDADE
  referenciaId String @map("referencia_id")

  posicaoX          Float?   @default(0.0) @map("posicao_x")
  posicaoY          Float?   @default(0.0) @map("posicao_y")
  nivelDominio      Float    @default(0.0) @map("nivel_dominio")
  ultimaAtualizacao DateTime @default(now()) @map("ultima_atualizacao")

  usuario Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  grafo   GrafosConhecimento? @relation(fields: [grafoId], references: [id], onDelete: Cascade)

  arestasOrigem  ConhecimentoAresta[] @relation("NodeOrigem")
  arestasDestino ConhecimentoAresta[] @relation("NodeDestino")
  desempenho     DesempenhoNo[]

  @@unique([usuarioId, grafoId, tipoNode, referenciaId], name: "_node_unique")
}

// ==========================================
// ARESTAS (RELACIONAMENTO DO GRAFO)
// ==========================================
model ConhecimentoAresta {
  id      String  @id @default(cuid())
  grafoId String? @map("id_grafo")

  nodeOrigemId  String? @map("id_node_origem")
  nodeDestinoId String? @map("id_node_destino")
  notaOrigemId  String? @map("id_nota_origem")
  notaDestinoId String? @map("id_nota_destino")

  tipoRelacao TipoRelacao
  peso        Float       @default(1.0)

  grafo       GrafosConhecimento? @relation(fields: [grafoId], references: [id], onDelete: Cascade)
  nodeOrigem  NodeConhecimento?   @relation("NodeOrigem", fields: [nodeOrigemId], references: [id], onDelete: Cascade)
  nodeDestino NodeConhecimento?   @relation("NodeDestino", fields: [nodeDestinoId], references: [id], onDelete: Cascade)
  notaOrigem  Nota?               @relation("ArestaNotaOrigem", fields: [notaOrigemId], references: [id], onDelete: Cascade)
  notaDestino Nota?               @relation("ArestaNotaDestino", fields: [notaDestinoId], references: [id], onDelete: Cascade)

  @@unique([nodeOrigemId, nodeDestinoId, tipoRelacao], name: "_edge_uk")
}

enum TipoRelacao {
  GERA
  REFERENCIA
  DEFINE
  EXPLICA
  APROFUNDA
  EXEMPLIFICA
  CONTRASTA
  SINTETIZA
  ALERTA_ERRO
  IS_A
  PART_OF
  PREREQUISITO
  DERIVA_DE
  EVOLUI_PARA
  REFORCA
  RELACIONADO
  TESTA
  TESTA_DEFINICAO
  PERTENCE_A
  SUBTOPICO_DE
  DEPENDE_DE
  FUNDAMENTA
  APLICADO_EM
  ALTERNATIVA_A
  CONTRASTA_COM
  CONFUNDE_COM
  ANTI_PADRAO_DE
  MEDIDO_POR
  OBJETIVO_DE
  HERDA
  COMPLEMENTAR
}

// ==========================================
// RESTO (SEM MUDANÇA FUNCIONAL)
// ==========================================
model SessaoEstudo {
  id         String    @id @default(cuid())
  usuarioId  String    @map("id_usuario")
  dataInicio DateTime  @default(now()) @map("data_inicio")
  dataFim    DateTime? @map("data_fim")

  usuario  Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  revisoes RevisaoFlashcard[]

  @@map("sessoes_estudo")
}

model RevisaoFlashcard {
  id              String  @id @default(cuid())
  flashcardId     String  @map("id_flashcard")
  sessaoId        String  @map("id_sessao")
  respostaUsuario String? @map("resposta_usuario")
  acertou         Boolean
  nivelConfianca  Int     @default(3) @map("nivel_confianca")
  tipoErro        String? @map("tipo_erro")
  tempoResposta   Int?    @map("tempo_resposta")

  flashcard Flashcard    @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  sessao    SessaoEstudo @relation(fields: [sessaoId], references: [id], onDelete: Cascade)

  @@map("revisoes_flashcard")
}

model AprendizadoFlashcard {
  flashcardId        String   @map("id_flashcard")
  usuarioId          String   @map("id_usuario")
  dificuldade        Int      @default(5)
  intervalo          Int      @default(0)
  proximaRevisao     DateTime @default(now()) @map("proxima_revisao")
  ultimaRevisao      DateTime @default(now()) @map("ultima_revisao")
  estagioAprendizado Int      @default(0) @map("estagio_aprendizado")

  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([flashcardId, usuarioId])
}

model DesempenhoNo {
  usuarioId         String @map("id_usuario")
  nodeId            String @map("id_node")
  taxaAcerto        Float  @default(0.0)
  confiancaMedia    Float  @default(0.0)
  prioridadeRevisao Int    @default(5)

  usuario Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  node    NodeConhecimento @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([usuarioId, nodeId])
}

model ConfigAI {
  id        String @id @default(cuid())
  usuarioId String @unique @map("id_usuario")
  apiKey    String @map("api_key")
  baseUrl   String @map("base_url")
  modelo    String @map("modelo")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}
