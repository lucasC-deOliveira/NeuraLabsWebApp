generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USUARIO
// ==========================================
model Usuario {
  id           String    @id @default(cuid())
  nome         String
  email        String    @unique
  senhaHash    String    @map("senha_hash")
  dataCriacao  DateTime  @default(now()) @map("data_criacao")
  ultimoAcesso DateTime? @map("ultimo_acesso")

  flashcards        Flashcard[]
  sessoesEstudo     SessaoEstudo[]
  aprendizagens     AprendizadoFlashcard[]
  desempenhoNos     DesempenhoNo[]
  notas             Nota[]
  textosBrutos      TextoBruto[]
  baralhos          Baralho[]
  configAI          ConfigAI?
  assuntos          Assunto[]
  nodesConhecimento NodeConhecimento[]
  grafos            GrafosConhecimento[]
  topicos           Topico[]
  conceitos         Conceito[]
  questoes          Questao[]
  provas            Prova[]
  editais           Edital[]
  roadmapTrilhas    RoadmapTrilha[]
  nodeEmbeddings    NodeEmbedding[]
  duplicateVerdicts DuplicateVerdictCache[]

  @@map("usuarios")
}

// ==========================================
// ENTIDADES BASE
// ==========================================
model Assunto {
  id        String  @id @default(cuid())
  usuarioId String  @map("id_usuario")
  nome      String
  descricao String?

  usuario Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  topicos Topico[]

  @@map("assuntos")
}

model Topico {
  id        String  @id @default(cuid())
  usuarioId String  @map("id_usuario")
  assuntoId String? @map("id_assunto")
  nome      String
  descricao String?

  usuario   Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  assunto   Assunto?   @relation(fields: [assuntoId], references: [id], onDelete: SetNull)
  conceitos Conceito[]

  @@map("topicos")
}

model Conceito {
  id        String  @id @default(cuid())
  usuarioId String  @map("id_usuario")
  topicoId  String? @map("id_topico")
  nome      String
  descricao String?

  usuario    Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  topico     Topico?     @relation(fields: [topicoId], references: [id], onDelete: SetNull)
  flashcards Flashcard[]
  questoes   Questao[]

  @@map("conceitos")
}

model Questao {
  id           String      @id @default(cuid())
  usuarioId    String      @map("id_usuario")
  conceitoId   String?     @map("id_conceito")
  tipo         TipoQuestao
  enunciado    String
  alternativas Json?
  gabarito     String
  explicacao   String?
  dataCriacao  DateTime    @default(now()) @map("data_criacao")

  usuario       Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  conceito      Conceito?       @relation(fields: [conceitoId], references: [id], onDelete: SetNull)
  provasQuestao ProvaQuestao[]
  imagens       QuestaoImagem[]

  @@map("questoes")
}

// Figuras extraídas do PDF da prova (ex.: esquemas, diagramas), exibidas junto
// ao enunciado. Os bytes ficam no Postgres (bytea) e são servidos por um endpoint.
model QuestaoImagem {
  id          String  @id @default(cuid())
  questaoId   String  @map("id_questao")
  ordem       Int     @default(0)
  mimetype    String
  dados       Bytes
  alternativa String? // letra A–E quando a figura é de uma alternativa-imagem; null = enunciado

  questao Questao @relation(fields: [questaoId], references: [id], onDelete: Cascade)

  @@index([questaoId])
  @@map("questoes_imagens")
}

model Prova {
  id          String   @id @default(cuid())
  usuarioId   String   @map("id_usuario")
  titulo      String
  descricao   String?
  dataCriacao DateTime @default(now()) @map("data_criacao")

  usuario  Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  questoes ProvaQuestao[]
  edital   Edital?

  @@map("provas")
}

// O edital (objetos de avaliação) de uma prova. Relação 1:1 com Prova — cada prova
// tem no máximo um edital e cada edital no máximo uma prova (provaId @unique).
model Edital {
  id          String   @id @default(cuid())
  usuarioId   String   @map("id_usuario")
  titulo      String
  programa    String
  provaId     String?  @unique @map("id_prova")
  dataCriacao DateTime @default(now()) @map("data_criacao")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  prova   Prova?  @relation(fields: [provaId], references: [id], onDelete: SetNull)

  @@map("editais")
}

// A persisted, ordered study roadmap for a graph under one prioritization mode
// ("ai" | "prova" | "edital" | "prova_edital"). Recomputed incrementally: new nodes
// are slotted into `itens` by priority; existing order is preserved. One per (graph, mode).
model RoadmapTrilha {
  id          String   @id @default(cuid())
  usuarioId   String   @map("id_usuario")
  grafoId     String   @map("id_grafo")
  modo        String
  itens       Json
  dataGeracao DateTime @default(now()) @updatedAt @map("data_geracao")

  usuario Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  grafo   GrafosConhecimento @relation(fields: [grafoId], references: [id], onDelete: Cascade)

  @@unique([grafoId, modo], name: "_trilha_uk")
  @@map("roadmap_trilhas")
}

model ProvaQuestao {
  id        String @id @default(cuid())
  provaId   String @map("id_prova")
  questaoId String @map("id_questao")
  ordem     Int    @default(0)

  prova   Prova   @relation(fields: [provaId], references: [id], onDelete: Cascade)
  questao Questao @relation(fields: [questaoId], references: [id], onDelete: Cascade)

  @@unique([provaId, questaoId])
  @@map("provas_questoes")
}

enum TipoFlashcard {
  DEFINICAO
  EXPLICACAO
  EXEMPLO
  APLICACAO
  CONTRASTE
  COMPLETAR
  ORDENACAO
  RELACIONAL
  ERRO_COMUM
}

enum TipoQuestao {
  VERDADEIRO_FALSO
  MULTIPLA_ESCOLHA
}

model Flashcard {
  id          String         @id @default(cuid())
  conceitoId  String?        @map("id_concept")
  usuarioId   String         @map("id_usuario")
  tipo        TipoFlashcard? @map("tipo")
  pergunta    String
  resposta    String
  dataCriacao DateTime       @default(now()) @map("data_criacao")

  conceito    Conceito?              @relation(fields: [conceitoId], references: [id], onDelete: Cascade)
  usuario     Usuario                @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  revisoes    RevisaoFlashcard[]
  aprendizado AprendizadoFlashcard[]
  baralhos    Baralho[]              @relation("BaralhoFlashcards")

  @@map("flashcards")
}

model Baralho {
  id          String   @id @default(cuid())
  usuarioId   String   @map("id_usuario")
  titulo      String
  dataCriacao DateTime @default(now()) @map("data_criacao")

  usuario    Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  flashcards Flashcard[] @relation("BaralhoFlashcards")

  @@map("baralhos")
}

enum SubtipoNota {
  DEFINICAO
  EXPLICACAO
  EXEMPLO
  COMPARACAO
  SINTESE
  PREREQUISITO
  ERRO_COMUM
  APLICACAO
}

model Nota {
  id              String       @id @default(cuid())
  usuarioId       String       @map("id_usuario")
  titulo          String       @default("Sem título")
  tipoNota        String       @default("PERMANENTE") @map("tipo_nota")
  subtipo         SubtipoNota?
  fonte           String?
  slug            String?
  conteudo        String
  dataCriacao     DateTime     @default(now()) @map("data_criacao")
  dataAtualizacao DateTime     @default(now()) @updatedAt @map("data_atualizacao")

  usuario        Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  arestasOrigem  ConhecimentoAresta[] @relation("ArestaNotaOrigem")
  arestasDestino ConhecimentoAresta[] @relation("ArestaNotaDestino")

  @@map("notas")
}

model TextoBruto {
  id          String   @id @default(cuid())
  usuarioId   String   @map("id_usuario")
  titulo      String   @default("Texto sem título")
  texto       String
  dataCriacao DateTime @default(now()) @map("data_criacao")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("textos_brutos")
}

// ==========================================
// GRAFO
// ==========================================
model GrafosConhecimento {
  id              String   @id @default(cuid())
  usuarioId       String   @map("id_usuario")
  nome            String
  descricao       String?
  estadoVisual    String?  @map("estado_visual")
  parentGrafoId   String?  @map("parent_grafo_id")
  tipoRelacaoPai  String?  @map("tipo_relacao_pai")
  // Assunto-raiz do grafo: ASSUNTO sintético com o nome do grafo, fixo no centro,
  // ancorando o layout. Não pode ser deletado individualmente (só com o grafo).
  rootAssuntoId   String?  @map("root_assunto_id")
  dataCriacao     DateTime @default(now()) @map("data_criacao")
  dataAtualizacao DateTime @default(now()) @updatedAt @map("data_atualizacao")

  usuario Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  parent  GrafosConhecimento?  @relation("GrafoHierarquia", fields: [parentGrafoId], references: [id], onDelete: SetNull)
  filhos  GrafosConhecimento[] @relation("GrafoHierarquia")

  nodes             NodeConhecimento[]
  arestas           ConhecimentoAresta[]
  roadmapTrilhas    RoadmapTrilha[]
  nodeEmbeddings    NodeEmbedding[]
  duplicateVerdicts DuplicateVerdictCache?

  @@map("grafos_conhecimento")
}

// Cache incremental do detector de duplicatas híbrido (IA): guarda, por assinatura
// de cluster candidato (nós + nomes normalizados), o veredicto do LLM. Num novo run
// só os clusters com assinatura nova (nó novo/renomeado) voltam ao LLM; o resto reusa
// o veredicto salvo. Uma linha por grafo; `dados` é o mapa assinatura → grupos.
model DuplicateVerdictCache {
  id           String   @id @default(cuid())
  usuarioId    String   @map("id_usuario")
  grafoId      String   @unique @map("id_grafo")
  dados        Json
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em")

  usuario Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  grafo   GrafosConhecimento @relation(fields: [grafoId], references: [id], onDelete: Cascade)

  @@map("duplicate_verdict_cache")
}

// Vetor de embedding por nó estrutural do grafo, para detecção de duplicatas
// semânticas por similaridade de cosseno (escala grafos grandes que não cabem no
// prompt do detector por LLM). Incremental: `assinatura` guarda o texto embutido,
// então só re-embute quando o nome muda. Chaveado por referenciaId (id da entidade).
model NodeEmbedding {
  id           String   @id @default(cuid())
  usuarioId    String   @map("id_usuario")
  grafoId      String   @map("id_grafo")
  referenciaId String   @map("referencia_id")
  tipoNode     TipoNode @map("tipo_node")
  assinatura   String   @map("assinatura")
  vetor        Float[]
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em")

  usuario Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  grafo   GrafosConhecimento @relation(fields: [grafoId], references: [id], onDelete: Cascade)

  @@unique([grafoId, referenciaId], name: "_embedding_unique")
  @@map("node_embeddings")
}

enum TipoNode {
  ASSUNTO
  TOPICO
  CONCEITO
  FLASHCARD
  NOTA
  TEXTO_BRUTO
  BARALHO
  QUESTION
  GRAFO_REF
  PROVA
  EDITAL
}

model NodeConhecimento {
  id        String  @id @default(cuid())
  usuarioId String  @map("id_usuario")
  grafoId   String? @map("id_grafo")

  tipoNode TipoNode

  referenciaId String @map("referencia_id")

  posicaoX          Float?   @default(0.0) @map("posicao_x")
  posicaoY          Float?   @default(0.0) @map("posicao_y")
  nivelDominio      Float    @default(0.0) @map("nivel_dominio")
  ultimaAtualizacao DateTime @default(now()) @map("ultima_atualizacao")

  usuario Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  grafo   GrafosConhecimento? @relation(fields: [grafoId], references: [id], onDelete: Cascade)

  arestasOrigem  ConhecimentoAresta[] @relation("NodeOrigem")
  arestasDestino ConhecimentoAresta[] @relation("NodeDestino")
  desempenho     DesempenhoNo[]

  @@unique([usuarioId, grafoId, tipoNode, referenciaId], name: "_node_unique")
}

model ConhecimentoAresta {
  id      String  @id @default(cuid())
  grafoId String? @map("id_grafo")

  nodeOrigemId  String? @map("id_node_origem")
  nodeDestinoId String? @map("id_node_destino")
  notaOrigemId  String? @map("id_nota_origem")
  notaDestinoId String? @map("id_nota_destino")

  tipoRelacao TipoRelacao
  peso        Float       @default(1.0)

  grafo       GrafosConhecimento? @relation(fields: [grafoId], references: [id], onDelete: Cascade)
  nodeOrigem  NodeConhecimento?   @relation("NodeOrigem", fields: [nodeOrigemId], references: [id], onDelete: Cascade)
  nodeDestino NodeConhecimento?   @relation("NodeDestino", fields: [nodeDestinoId], references: [id], onDelete: Cascade)
  notaOrigem  Nota?               @relation("ArestaNotaOrigem", fields: [notaOrigemId], references: [id], onDelete: Cascade)
  notaDestino Nota?               @relation("ArestaNotaDestino", fields: [notaDestinoId], references: [id], onDelete: Cascade)

  @@unique([nodeOrigemId, nodeDestinoId, tipoRelacao], name: "_edge_uk")
}

enum TipoRelacao {
  GERA
  REFERENCIA
  DEFINE
  EXPLICA
  APROFUNDA
  EXEMPLIFICA
  CONTRASTA
  SINTETIZA
  ALERTA_ERRO
  IS_A
  PART_OF
  PREREQUISITO
  DERIVA_DE
  EVOLUI_PARA
  REFORCA
  RELACIONADO
  TESTA
  TESTA_DEFINICAO
  PERTENCE_A
  SUBTOPICO_DE
  DEPENDE_DE
  FUNDAMENTA
  APLICADO_EM
  ALTERNATIVA_A
  CONTRASTA_COM
  CONFUNDE_COM
  ANTI_PADRAO_DE
  MEDIDO_POR
  OBJETIVO_DE
  HERDA
  CONTEM
  COMPLEMENTAR
  REGE
  COBRE
}

// ==========================================
// ESTUDO / SRS
// ==========================================
model SessaoEstudo {
  id         String    @id @default(cuid())
  usuarioId  String    @map("id_usuario")
  dataInicio DateTime  @default(now()) @map("data_inicio")
  dataFim    DateTime? @map("data_fim")

  usuario  Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  revisoes RevisaoFlashcard[]

  @@map("sessoes_estudo")
}

model RevisaoFlashcard {
  id              String  @id @default(cuid())
  flashcardId     String  @map("id_flashcard")
  sessaoId        String  @map("id_sessao")
  respostaUsuario String? @map("resposta_usuario")
  acertou         Boolean
  nivelConfianca  Int     @default(3) @map("nivel_confianca")
  tipoErro        String? @map("tipo_erro")
  tempoResposta   Int?    @map("tempo_resposta")

  flashcard Flashcard    @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  sessao    SessaoEstudo @relation(fields: [sessaoId], references: [id], onDelete: Cascade)

  @@map("revisoes_flashcard")
}

model AprendizadoFlashcard {
  flashcardId        String   @map("id_flashcard")
  usuarioId          String   @map("id_usuario")
  dificuldade        Int      @default(5)
  intervalo          Int      @default(0)
  fatorEase          Float    @default(2.5) @map("fator_ease")
  fase               String   @default("LEARN") @map("fase")
  learningStep       Int      @default(0) @map("learning_step")
  proximaRevisao     DateTime @default(now()) @map("proxima_revisao")
  ultimaRevisao      DateTime @default(now()) @map("ultima_revisao")
  estagioAprendizado Int      @default(0) @map("estagio_aprendizado")

  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([flashcardId, usuarioId])
}

model DesempenhoNo {
  usuarioId         String @map("id_usuario")
  nodeId            String @map("id_node")
  taxaAcerto        Float  @default(0.0)
  confiancaMedia    Float  @default(0.0)
  prioridadeRevisao Int    @default(5)

  usuario Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  node    NodeConhecimento @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([usuarioId, nodeId])
}

model ConfigAI {
  id        String @id @default(cuid())
  usuarioId String @unique @map("id_usuario")
  apiKey    String @map("api_key")
  baseUrl   String @map("base_url")
  modelo    String @map("modelo")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

// Config global (singleton). storageMode: DATABASE | MARKDOWN (+ vaultPath).
model AppConfig {
  id                 String   @id @default("singleton")
  storageMode        String   @default("DATABASE") @map("storage_mode")
  vaultPath          String?  @map("vault_path")
  googleClientId     String?  @map("google_client_id")
  googleClientSecret String?  @map("google_client_secret")
  githubClientId     String?  @map("github_client_id")
  githubClientSecret String?  @map("github_client_secret")
  atualizadoEm       DateTime @default(now()) @updatedAt @map("atualizado_em")

  @@map("app_config")
}
